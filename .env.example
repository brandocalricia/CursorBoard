# High Dashboard — local secrets (copy to .env.local)
# Never commit real tokens.

GITHUB_TOKEN=

# Preferred Canvas path: Composio OAuth (not limited to DU's 30-day manual tokens)
COMPOSIO_API_KEY=
COMPOSIO_CANVAS_ACCOUNT_ID=canvas_since-ergal
# COMPOSIO_API_BASE=https://backend.composio.dev

# Last-resort manual Canvas token (max ~30 days at canvas.du.edu)
# CANVAS_API_TOKEN=
# CANVAS_BASE_URL=https://canvas.du.edu

INGEST_SECRET=

# Optional override for data directory (default: ~/.high-dashboard)
# HIGH_DASHBOARD_HOME=
