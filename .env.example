# High Dashboard — local secrets (copy to .env.local)
# Never commit real tokens.

GITHUB_TOKEN=

# Preferred: Composio Platform project key (ak_…). Connect keys (ck_…) are ignored.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_ACCOUNT_ID=
COMPOSIO_CALENDAR_ACCOUNT_ID=
COMPOSIO_CANVAS_ACCOUNT_ID=
# COMPOSIO_API_BASE=https://backend.composio.dev

# Optional Gmail without Composio — Google Account → App passwords
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Last-resort manual Canvas token (max ~30 days at canvas.du.edu)
# CANVAS_API_TOKEN=
# CANVAS_BASE_URL=https://canvas.du.edu

INGEST_SECRET=

# Optional override for data directory (default: ~/.high-dashboard)
# HIGH_DASHBOARD_HOME=
